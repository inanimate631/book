MONOBANK_TOKEN=your_monobank_token
BOOK_PRICE_UAH=700
PUBLIC_APP_URL=https://your-domain.vercel.app
MONOBANK_WEBHOOK_URL=https://your-domain.vercel.app/api/monobank/webhook
ORDER_EMAIL=info@denkiiashko.com
NOVA_POSHTA_API_KEY=your_nova_poshta_api_key
# Optional. Responses are cached in Node.js memory for 24 hours by default.
NOVA_POSHTA_CACHE_TTL_MS=86400000

# Optional but recommended for serverless deployments.
# Add a Vercel KV/Upstash Redis integration and copy these values from it.
KV_REST_API_URL=https://your-redis-endpoint
KV_REST_API_TOKEN=your_redis_token
